{
  "name": "tolochatracks",
  "version": "0.7.0",
  "private": true,
  "description": "Registro rápido de rutas GPS: correr, senderismo, bicicleta y más (Flutter)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
